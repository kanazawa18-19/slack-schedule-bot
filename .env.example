# Slack
SLACK_BOT_TOKEN=xoxb-xxxx        # Bot Token（OAuth & Permissions）
SLACK_APP_TOKEN=xapp-xxxx        # App Token（Socket Mode有効化後）

# Google Calendar
GOOGLE_CREDENTIALS_FILE=credentials.json   # GCP OAuth2クライアントJSON
GOOGLE_CALENDAR_ID=primary                 # 対象カレンダーID
OAUTH_REDIRECT_URI=https://your-server.com/oauth/callback  # OAuthコールバックURL
TOKENS_DIR=tokens                          # ユーザーごとのトークン保存先ディレクトリ
PORT=8080                                  # Flaskサーバーのポート
